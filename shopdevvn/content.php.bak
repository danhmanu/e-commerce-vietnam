<article class="post-box <?php if(has_post_thumbnail()):?>has_thumbnail<?php endif;?>">
	<?php if(has_post_thumbnail()):?>
	<div class="post-img">
		<a href="<?php the_permalink(); ?>" title="<?php the_title(); ?>" rel="nofollow">
			<?php the_post_thumbnail('shop_catalog');?>
		</a>
	</div>
	<?php endif;?>
	<div class="post-data">
		<div class="post-data-container">
			<header>
				<h2 class="title post-title"><a href="<?php the_permalink(); ?>" title="<?php the_title(); ?>"><?php the_title(); ?></a></h2>
				<div class="post-info">
                	<span class="thetime updated"><i class="fa fa-clock-o"></i> <span><?php echo get_the_date()?></span></span>
                </div>
			</header>
			<div class="post-excerpt">
				<?php the_excerpt();?>				
			</div>
			<a href="<?php the_permalink()?>" title="<?php the_title()?>" rel="nofollow" class="read_more"><?php _e('Xem thêm','devvn');?></a>
		</div>
	</div>
</article>