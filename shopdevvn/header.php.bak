  	<body <?php body_class();?> itemscope itemtype="http://schema.org/WebPage">
    <?php do_action('devvn_after_body');?>
  	<header class="header" itemscope itemtype="http://schema.org/WPHeader">
  		<?php 
  		$kich_hoat_top_header = get_field('kich_hoat_top_header','option');
  		$top_header_left = get_field('top_header_left','option');
  		$top_header_middle = get_field('top_header_middle','option');
  		$top_header_right = get_field('top_header_right','option');
  		$login_header = get_field('login_header','option');
  		if($kich_hoat_top_header):
  		?>
  		<div class="top_header">
  			<div class="container">
                <?php if(has_nav_menu('top_nav')):?>
                    <div class="top_header_left"><?php wp_nav_menu(array('theme_location'  => 'top_nav','container'=> ''));?></div>
                <?php elseif($top_header_left):?>
                    <div class="top_header_left"><?php echo $top_header_left;?></div>
                <?php endif;?>
  				<?php if($top_header_middle):?><div class="top_header_middle"><?php echo $top_header_middle;?></div><?php endif;?>
  				<?php if($top_header_right || $login_header):?>
                <div class="top_header_right">
                    <?php if($top_header_right):?>
                    <span class="text_header_right">
                        <?php echo $top_header_right;?>
                    </span>
                    <?php endif;?>
                    <?php if($login_header):?>
                        <?php $myaccount_page_id = get_option( 'woocommerce_myaccount_page_id' );?>
                        <?php if(is_user_logged_in() && $myaccount_page_id):?>
                            <span class="header_account"><a href="<?php echo get_permalink( $myaccount_page_id );?>"><?php echo get_the_title($myaccount_page_id);?></a></span>
                        <?php else:?>
                            <span class="header_account"><a href="<?php echo get_permalink( $myaccount_page_id );?>"><?php _e('Đăng nhập | Đăng ký','devvn')?></a></span>
                        <?php endif;?>
                    <?php endif;?>
                </div>
                <?php endif;?>
  			</div>
  		</div>
  		<?php endif;?>
  		<div class="main_header">
	  		<div class="container tl-hdr">
	  			<div class="logo">
		  			<?php 
		  			$logo = get_field('logo','option');
		  			$logo = ($logo) ? $logo : TEMP_URL.'/images/logo.png';
		  			?>
		  			<a class="tl-brand" href="<?=esc_url(home_url('/'))?>" title="Dịch Vụ Kỹ Thuật Tiên Lập – sửa chữa, bảo trì, cung cấp thiết bị y tế &amp; thẩm mỹ"><img src="<?=$logo?>" alt="Logo Dịch Vụ Kỹ Thuật Tiên Lập" width="60" height="60"/><span class="tl-brand-text"><span class="tl-brand-name">Dịch Vụ Kỹ Thuật <b>Tiên Lập</b></span><span class="tl-brand-tag">Sửa chữa · Bảo trì · Cung cấp thiết bị y tế &amp; thẩm mỹ</span></span></a>
		  		</div>
		  		<div class="search_header">
		  			<?php get_product_search_form();?>
                    <?php do_action('devvn_after_search_header');?>
		  		</div>
		  		<div class="tl-hdr-cta">
		  			<a class="tl-hdr-hotline" href="tel:0903304691"><i class="fa fa-phone"></i><span><small>Hotline kỹ thuật</small><b>0903 304 691</b></span></a>
		  			<a class="tl-hdr-btn" href="<?=esc_url(home_url('/lien-he/'))?>">Yêu cầu kỹ thuật</a>
		  		</div>
                <?php if(!get_field('has_cart_header','option') && !get_field('hidden_shopping','option')):?>
		  		<div class="cart_header woocommerce">
		  			<div class="popup_cart_hover">
			  			<?php do_action('woo_mini_cart');?>
			  			<div class="popup_cart mini-cart-body"><?php woocommerce_mini_cart();?></div>
		  			</div>
		  		</div>
                <?php endif;?>
	  		</div>
  		</div>
        <div class="menu_header_wrap">
            <div class="container">
                <?php
                if(false && show_megamenu_sidebar(true)): // Tiên Lập: bỏ nút "Danh mục sản phẩm"
                ?>
                <div class="danhmuc_sanpham_menu">
                    <div class="title-sidebar click_open_mega"><?php _e('Danh mục sản phẩm','devvn');?><i class="fa fa-bars"></i></div>
                    <?php do_action('devvn_content_danhmuc');?>
                </div>
                <?php endif;?>
                <?php if(has_nav_menu('header')):?>
                    <a href="#" class="button_open_menu"><i class="fa fa-bars"></i> Menu</a>
                    <div class="menu_header" role="navigation" itemscope="" itemtype="http://schema.org/SiteNavigationElement">
                        <?php wp_nav_menu(array('theme_location'  => 'header','container'=> ''));?>
